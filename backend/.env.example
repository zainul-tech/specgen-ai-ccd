# Copy this file to .env and fill in real values before running.

# Secret used to sign JWTs. Generate one with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret

# Anthropic API key — the "LLM Provider API" from the SRS architecture diagram.
# Get one at https://console.anthropic.com/ — it's pay-as-you-go (prepaid credits,
# no permanent free tier), but the default model below keeps real cost under a
# cent per generation, so building and demoing this project costs well under $1 total.
ANTHROPIC_API_KEY=

# Optional: override the generation model. Defaults to Haiku (cheapest, fine for
# this structured-JSON use case). Set to e.g. claude-sonnet-4-5 for higher quality
# once cost isn't a concern.
ANTHROPIC_MODEL=

# Defaults to a local SQLite file. For PostgreSQL (as specified in the SRS):
# DATABASE_URL=postgresql://user:password@localhost:5432/specgen
DATABASE_URL=sqlite:///./specgen.db
